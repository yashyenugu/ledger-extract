# Postgres container credentials (postgres image reads these directly)
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger_extract

# API settings — read directly by api/app/settings.py
DATABASE_URL=postgresql+psycopg://ledger:ledger@postgres:5432/ledger_extract
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# Frontend
VITE_API_URL=http://localhost:8000
